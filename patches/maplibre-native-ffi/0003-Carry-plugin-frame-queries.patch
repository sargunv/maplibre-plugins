+ #include <mln/util/projection.hpp>
+@@ -29,6 +31,7 @@
+ #include <mapbox/cheap_ruler.hpp>
+ 
+ #include <chrono>
++#include <cmath>
+ #include <cstring>
+ #include <set>
+ 
+@@ -70,6 +73,43 @@ void destinationToLatLng(const mln_plugin_frame_context_v1* context,
+ 
+ RenderPluginStyleLayer::~RenderPluginStyleLayer() = default;
+ 
++void RenderPluginStyleLayer::populateDynamicRenderFeatureIndex(DynamicFeatureIndex& index) const {
++    for (const auto& [feature, envelope] : frameFeatures) index.insert(feature, envelope);
++}
++
++bool RenderPluginStyleLayer::copyFrameFeatures(const mln_plugin_bucket_v1& output) {
++    if (output.frame_feature_count && !output.frame_features) return false;
++    for (size_t i = 0; i < output.frame_feature_count; ++i) {
++        const auto& input = output.frame_features[i];
++        if (input.struct_size < sizeof(input) || !input.geojson.data || (input.polygon_count && !input.polygons))
++            return false;
++        style::conversion::Error error;
++        auto json = style::conversion::parseGeoJSON(std::string(input.geojson.data, input.geojson.size), error);
++        if (!json || !json->is<GeoJSONFeature>()) return false;
++        auto feature = std::make_shared<Feature>(json->get<GeoJSONFeature>());
++        feature->sourceLayer = getID();
++        auto envelope = std::make_shared<mapbox::geometry::multi_polygon<int64_t>>();
++        for (size_t j = 0; j < input.polygon_count; ++j) {
++            const auto& polygon = input.polygons[j];
++            if (polygon.struct_size < sizeof(polygon) || polygon.point_count < 3 || !polygon.points) return false;
++            mapbox::geometry::linear_ring<int64_t> ring;
++            for (size_t k = 0; k < polygon.point_count; ++k) {
++                const auto& point = polygon.points[k];
++                // A strict bound avoids undefined conversion at INT64_MAX rounded to double.
++                constexpr double limit = 9223372036854775808.0;
++                if (!std::isfinite(point.x) || !std::isfinite(point.y) || point.x <= -limit || point.x >= limit ||
++                    point.y <= -limit || point.y >= limit)
++                    return false;
++                ring.emplace_back(static_cast<int64_t>(point.x), static_cast<int64_t>(point.y));
++            }
++            ring.push_back(ring.front());
++            envelope->push_back({std::move(ring)});
++        }
++        frameFeatures.emplace_back(std::move(feature), std::move(envelope));
++    }
++    return true;
++}
++
+ RenderPluginStyleLayer::RenderPluginStyleLayer(Immutable<style::PluginStyleLayer::Impl> impl)
+     : RenderLayer(makeMutable<style::PluginStyleLayerProperties>(std::move(impl))) {
+     // Unlike generated layers, a plugin layer has no generated evaluated
+@@ -405,6 +445,7 @@ void RenderPluginStyleLayer::updateFrame(gfx::ShaderRegistry& shaders,
+     std::copy(projMatrix.begin(), projMatrix.end(), frameContext.proj_matrix);
+     frameContext.project_mercator = &projectToMercatorPixels;
+     frameContext.destination = &destinationToLatLng;
++    frameFeatures.clear();
+ 
+     mln_plugin_bucket_v1 output{};
+     output.struct_size = sizeof(output);
+@@ -412,22 +453,24 @@ void RenderPluginStyleLayer::updateFrame(gfx::ShaderRegistry& shaders,
+         Log::Error(Event::Style, "Plugin layer '" + getID() + "' failed to build its frame");
+         removeAllDrawables();
+         frameBucket.reset();
++        frameFeatures.clear();
+         return;
+     }
+ 
+-    // Copy the frame bucket. Feature ranges do not exist for source-free
+-    // layers, and neither does feature hit-testing.
++    // Copy geometry and query snapshots before another plugin callback runs.
+     if (output.vertex_stream_count == 0 || output.drawable_count == 0 || output.index_count == 0) {
+         removeAllDrawables();
+         frameBucket.reset();
++        frameFeatures.clear();
+         return;
+     }
+ 
+     auto nextBucket = std::make_shared<PluginBucket>(registration);
+-    if (!nextBucket->copyGeometry(output) || output.feature_vertex_range_count != 0) {
++    if (!nextBucket->copyGeometry(output) || output.feature_vertex_range_count != 0 || !copyFrameFeatures(output)) {
+         Log::Error(Event::Style, "Plugin layer '" + getID() + "' returned a malformed frame bucket");
+         removeAllDrawables();
+         frameBucket.reset();
++        frameFeatures.clear();
+         return;
+     }
+     const auto zoom = static_cast<float>(state.getZoom());
+diff --git a/src/mln/renderer/layers/render_plugin_style_layer.hpp b/src/mln/renderer/layers/render_plugin_style_layer.hpp
+index 4da778bb5e4b89cbe2154bdad38a590740a2cb9e..b52a963511b3ee47e7c092d62a0bfb4e5c8e08bc 100644
+--- a/src/mln/renderer/layers/render_plugin_style_layer.hpp
++++ b/src/mln/renderer/layers/render_plugin_style_layer.hpp
+@@ -2,6 +2,7 @@
+ 
+ #include <mln/renderer/render_layer.hpp>
