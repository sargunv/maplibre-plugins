+diff --git a/include/mln/plugin/plugin_api.h b/include/mln/plugin/plugin_api.h
+--- a/include/mln/plugin/plugin_api.h
++++ b/include/mln/plugin/plugin_api.h
+@@ -361,6 +361,22 @@ typedef struct mln_plugin_feature_vertex_range_v1 {
+     uint32_t vertex_count;
+ } mln_plugin_feature_vertex_range_v1;
+ 
++/* Source-free rendered features use the same world-pixel bounding envelopes as
++ * native dynamic layers. Points are Mercator world pixels at the frame zoom.
++ * Each feature is a single GeoJSON Feature; polygons are independent hit areas. */
++typedef struct mln_plugin_query_polygon_v1 {
++    uint32_t struct_size;
++    const mln_plugin_double2* points;
++    size_t point_count;
++} mln_plugin_query_polygon_v1;
++
++typedef struct mln_plugin_frame_feature_v1 {
++    uint32_t struct_size;
++    mln_plugin_string geojson;
++    const mln_plugin_query_polygon_v1* polygons;
++    size_t polygon_count;
++} mln_plugin_frame_feature_v1;
++
+ /* The bucket struct is host-owned. All views written into it, including nested
+  * drawable strings/arrays, indices, vertex bytes and feature ranges, remain
+  * plugin-owned and valid until destroy_layout. On success the host copies them
+@@ -378,6 +394,9 @@ typedef struct mln_plugin_bucket_v1 {
+     float query_radius;
+     const mln_plugin_feature_vertex_range_v1* feature_vertex_ranges;
+     size_t feature_vertex_range_count;
++    /* Frame-only views, copied before the next callback on this thread. */
++    const mln_plugin_frame_feature_v1* frame_features;
++    size_t frame_feature_count;
+ } mln_plugin_bucket_v1;
+ 
+ /*
+diff --git a/src/mln/renderer/layers/render_plugin_style_layer.cpp b/src/mln/renderer/layers/render_plugin_style_layer.cpp
+--- a/src/mln/renderer/layers/render_plugin_style_layer.cpp
++++ b/src/mln/renderer/layers/render_plugin_style_layer.cpp
+@@ -1,5 +1,6 @@
+ #include <mln/renderer/layers/render_plugin_style_layer.hpp>
+ 
++#include <mln/geometry/feature_index.hpp>
+ #include <mln/gfx/context.hpp>
+ #include <mln/gfx/color_mode.hpp>
+ #include <mln/gfx/cull_face_mode.hpp>
+@@ -22,6 +23,7 @@
+ #include <mln/renderer/paint_parameters.hpp>
