++// A 3x5 texture whose corner texels hold extreme f32 values in different
++// channels; every other component is distinct. The shader compares all four
++// corner texels exactly, so a transposed, flipped, filtered or converted upload
++// turns the pixel red. Its id is the last slot, so no binding defaults to it.
++constexpr uint32_t exactTextureID = MLN_PLUGIN_MAX_TEXTURES - 1;
++constexpr uint32_t exactWidth = 3;
++constexpr uint32_t exactHeight = 5;
++
++const std::vector<float>& exactTexels() {
++    static const auto texels = [] {
++        std::vector<float> values(exactWidth * exactHeight * 4);
++        for (std::size_t i = 0; i < values.size(); ++i) values[i] = 1.0f + static_cast<float>(i) * 0.25f;
++        values[0] = 16777215.0f;                                  // (0, 0).x
++        values[(exactWidth - 1) * 4 + 1] = -0.1234567f;           // (2, 0).y
++        values[exactWidth * (exactHeight - 1) * 4 + 2] = 1e-7f;   // (0, 4).z
++        values[(exactWidth * exactHeight - 1) * 4 + 3] = 3.4e38f; // (2, 4).w
++        return values;
++    }();
++    return texels;
++}
