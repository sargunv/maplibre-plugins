++// Appends a segment with a clip-space quad from x0 to x1 at full height, owned
++// by one feature. Segment indices are relative to the segment's first vertex.
++void addQuad(TestLayout& layout, uint64_t feature, float x0, float x1) {
++    const auto first = static_cast<uint32_t>(layout.vertices.size() / 2);
++    const auto firstIndex = static_cast<uint32_t>(layout.indices.size());
++    layout.vertices.insert(layout.vertices.end(), {x0, -1, x1, -1, x0, 1, x1, 1});
++    layout.indices.insert(layout.indices.end(), {0, 1, 2, 1, 3, 2});
++    layout.segments.push_back({sizeof(mln_plugin_segment_v1), first, firstIndex, 4, 6});
++    layout.ranges.push_back({sizeof(mln_plugin_feature_vertex_range_v1), feature, 1, first, 4});
