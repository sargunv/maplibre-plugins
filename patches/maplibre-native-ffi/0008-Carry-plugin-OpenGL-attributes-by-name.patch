++// Every kind of data-driven paint attribute, drawn from two features in two
++// segments of one drawable. The left half of the viewport draws the first
++// feature and the right half the second; each half shows the resolved values
++// in columns of 8 pixels:
++//   0: (p-scalar, p-pair.x, p-pair.y)   1: p-color.rgb
++//   2: (p-state, p-cam, p-color.a)      3: (p-scalar minimum, maximum, factor)
++// p-cam is camera-only and sits between data-driven attributes, so its
++// attribute is always left out of the program.
++mln_plugin_status twoFeatureQuads(void* instance, mln_plugin_bucket_v1* output) {
++    auto& layout = *static_cast<TestLayout*>(instance);
++    auto features = layout.features;
++    std::sort(features.begin(), features.end(), [](const auto& a, const auto& b) { return a.second.x < b.second.x; });
++    for (std::size_t i = 0; i < features.size() && i < 2; ++i) {
++        addQuad(layout, features[i].first, i == 0 ? -1.0f : 0.0f, i == 0 ? 0.0f : 1.0f);
++    }
++    writeBucket(layout, output);
++    return MLN_PLUGIN_STATUS_OK;
++}
