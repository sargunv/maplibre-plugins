+-/* Stable IDs are local to one registered plugin layer type. */
++/* Stable IDs are local to one registered plugin layer type. On OpenGL the host
++ * matches active attributes to declared ones by name, so layout(location = N)
++ * is optional there. Vulkan (layout(location = N)) and Metal
++ * ([[attribute(N)]]) must declare every attribute at its location. */
+ typedef struct mln_plugin_shader_attribute_v1 {
+     uint32_t struct_size;
+     uint32_t attribute_id;
+diff --git a/src/mln/shaders/gl/shader_program_gl.cpp b/src/mln/shaders/gl/shader_program_gl.cpp
+--- a/src/mln/shaders/gl/shader_program_gl.cpp
++++ b/src/mln/shaders/gl/shader_program_gl.cpp
+@@ -7,7 +7,9 @@
+ #include <mln/shaders/program_parameters.hpp>
+ #include <mln/shaders/shader_manifest.hpp>
+ 
++#include <algorithm>
+ #include <cstring>
++#include <string_view>
+ #include <utility>
+ 
+ namespace mln {
+@@ -173,8 +175,17 @@ std::shared_ptr<ShaderProgramGL> ShaderProgramGL::create(
+                 continue;
+             }
+             const GLint location = MBGL_CHECK_ERROR(glGetAttribLocation(program, name.data()));
+-            assert(attributesInfo[location].name == std::string_view(name.data()));
+-            addAttr(attrs, attributesInfo[location].id, location, length, size, glType);
++            // Match by name: a location is not an index into the list. Plugin
++            // shaders pass only the attributes of their current variant, and
++            // the linker places attributes without an explicit location.
++            const std::string_view attributeName(name.data(), static_cast<size_t>(length));
++            const auto info = std::ranges::find_if(
++                attributesInfo, [&](const auto& attribute) { return attribute.name == attributeName; });
++            if (info == attributesInfo.end()) {
++                assert(false && "active attribute was not declared");
++                continue;
++            }
++            addAttr(attrs, info->id, location, length, size, glType);
+         }
+ 
+         return std::make_shared<ShaderProgramGL>(std::move(program), std::move(attrs), std::move(samplerLocations));
