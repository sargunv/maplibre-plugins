++               location(1, vulkan) + "in vec2 a_one;\n#endif\n#if !MLN_PLUGIN_PROPERTY_TEST_TWO_IS_UNIFORM\n" +
++               location(2, vulkan) + "in vec2 a_two;\n#endif\n";
