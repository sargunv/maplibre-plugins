--- /dev/null
+++ b/patches/maplibre-native/0027-opengl-large-uniform-blocks.patch
@@ -0,0 +1,157 @@
+diff --git a/src/mln/gl/buffer_allocator.cpp b/src/mln/gl/buffer_allocator.cpp
+--- a/src/mln/gl/buffer_allocator.cpp
++++ b/src/mln/gl/buffer_allocator.cpp
+@@ -212,13 +212,9 @@ public:
+             occupancyBytes -= bufObj->getSize();
+         }
+ 
+-        // Align a pointer on a set block size
+-        static size_t align(size_t ptr, size_t alignment) {
+-            if (ptr == alignment) {
+-                return ptr;
+-            }
+-            return ((ptr + alignment) / alignment) * alignment;
+-        }
++        // Round a size up to a multiple of the alignment. An exact multiple stays as
++        // is, so an allocation of a whole page still fits in one.
++        static size_t align(size_t ptr, size_t alignment) { return ((ptr + alignment - 1) / alignment) * alignment; }
+     };
+ 
+ public:
+diff --git a/src/mln/gl/uniform_buffer_gl.cpp b/src/mln/gl/uniform_buffer_gl.cpp
+--- a/src/mln/gl/uniform_buffer_gl.cpp
++++ b/src/mln/gl/uniform_buffer_gl.cpp
+@@ -141,7 +141,9 @@ void UniformBufferGL::update(const void* data, std::size_t dataSize) {
+         return;
+     }
+ 
+-    if (std::memcmp(data, managedBuffer.getContents().data(), dataSize) == 0) {
++    // Only allocator-managed buffers keep a CPU copy to compare against. A buffer
++    // too large for the allocator owns its GL buffer and has no copy, so always upload.
++    if (isManagedAllocation && std::memcmp(data, managedBuffer.getContents().data(), dataSize) == 0) {
+         return;
+     }
+ 
+diff --git a/test/plugin/rendering.test.cpp b/test/plugin/rendering.test.cpp
+--- a/test/plugin/rendering.test.cpp
