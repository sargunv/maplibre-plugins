{
  "id": "osm-buildings",
  "type": "building",
  "source": "osm-buildings",
  "layout": {
    "building-roof-shape": [
      "match",
      ["get", "roof:shape"],
      "flat",
      "flat",
      "gabled",
      "gabled",
      "hipped",
      "hipped",
      "half-hipped",
      "half-hipped",
      "pyramidal",
      "pyramidal",
      "skillion",
      "skillion",
      "gambrel",
      "gambrel",
      "round",
      "round",
      "double_saltbox",
      "double_saltbox",
      "saltbox",
      "saltbox",
      "mansard",
      "mansard",
      "dome",
      "dome",
      "quadruple_saltbox",
      "quadruple_saltbox",
      "round_gabled",
      "round_gabled",
      "onion",
      "onion",
      "cone",
      "cone",
      "many",
      "many",
      ["pitched", "gable", "crosspitched"],
      "gabled",
      ["hip", "side_hipped"],
      "hipped",
      ["half_hipped", "side_half-hipped", "hipped-and-gabled"],
      "half-hipped",
      ["pyramid"],
      "pyramidal",
      ["lean_to", "monopitch", "mono-pitched", "shed", "single"],
      "skillion",
      ["barrel", "arched"],
      "round",
      ["spherical", "half-dome"],
      "dome",
      ["conical"],
      "cone",
      "flat"
    ],
    "building-roof-orientation": [
      "match",
      ["get", "roof_orientation"],
      "across",
      "across",
      "along"
    ],
    "building-roof-direction": ["coalesce", ["get", "roof_direction_deg"], -1]
  },
  "paint": {
    "building-height": [
      "case",
      ["has", "height_m"],
      ["get", "height_m"],
      [
        "+",
        [
          "*",
          3,
          [
            "coalesce",
            ["get", "levels"],
            ["max", 2, ["+", 1, ["coalesce", ["get", "min_level"], 0]]]
          ]
        ],
        [
          "match",
          ["get", "roof:shape"],
          [
            "gabled",
            "hipped",
            "half-hipped",
            "pyramidal",
            "skillion",
            "gambrel",
            "round",
            "double_saltbox",
            "saltbox",
            "mansard",
            "dome",
            "quadruple_saltbox",
            "round_gabled",
            "onion",
            "cone",
            "pitched",
            "gable",
            "crosspitched",
            "hip",
            "side_hipped",
            "half_hipped",
            "side_half-hipped",
            "hipped-and-gabled",
            "pyramid",
            "lean_to",
            "monopitch",
            "mono-pitched",
            "shed",
            "single",
            "barrel",
            "arched",
            "spherical",
            "half-dome",
            "conical"
          ],
          [
            "case",
            ["has", "roof_height_m"],
            ["get", "roof_height_m"],
            ["has", "roof_levels"],
            ["*", 3, ["get", "roof_levels"]],
            [
              "match",
              ["get", "roof:shape"],
              [
                "skillion",
                "lean_to",
                "monopitch",
                "mono-pitched",
                "shed",
                "single"
              ],
              2,
              ["pyramidal", "dome", "pyramid", "spherical", "half-dome"],
              4,
              ["onion", "cone", "conical"],
              6,
              3
            ]
          ],
          0
        ]
      ]
    ],
    "building-base": [
      "case",
      ["has", "min_height_m"],
      ["get", "min_height_m"],
      ["*", 3, ["coalesce", ["get", "min_level"], 0]]
    ],
    "building-roof-height": [
      "case",
      ["has", "roof_height_m"],
      ["get", "roof_height_m"],
      ["has", "roof_levels"],
      ["*", 3, ["get", "roof_levels"]],
      [
        "match",
        ["get", "roof:shape"],
        ["skillion", "lean_to", "monopitch", "mono-pitched", "shed", "single"],
        2,
        ["pyramidal", "dome", "pyramid", "spherical", "half-dome"],
        4,
        ["onion", "cone", "conical"],
        6,
        3
      ]
    ],
    "building-roof-angle": [
      "case",
      ["has", "roof_height_m"],
      0,
      ["coalesce", ["get", "roof_angle_deg"], 0]
    ],
    "building-color": [
      "to-color",
      ["get", "building_color"],
      [
        "match",
        ["get", "building:material"],
        "brick",
        "#a8644c",
        ["stone", "limestone", "sandstone"],
        "#bdb5a6",
        ["wood", "timber_framing"],
        "#8f6d4c",
        "glass",
        "#a7bfcc",
        ["concrete", "cement_block"],
        "#c5c3bd",
        ["metal", "steel"],
        "#9aa0a6",
        "#ece4d3"
      ]
    ],
    "building-roof-color": [
      "to-color",
      ["get", "roof_color"],
      [
        "match",
        ["get", "roof:material"],
        "roof_tiles",
        "#b35a3c",
        "copper",
        "#6f9e8b",
        "slate",
        "#4f5661",
        ["stone", "limestone"],
        "#8f8a80",
        ["metal", "tin"],
        "#8c939a",
        "glass",
        "#b8d2dc",
        ["concrete", "tar_paper", "asphalt"],
        "#7d7d7d",
        "gravel",
        "#a39d93",
        "grass",
        "#7c9a5a",
        [
          "match",
          ["get", "roof:shape"],
          ["flat", "many"],
          "#8e8e8e",
          ["dome", "onion", "cone", "spherical", "half-dome", "conical"],
          "#6f9e8b",
          [
            "gabled",
            "hipped",
            "half-hipped",
            "pyramidal",
            "skillion",
            "gambrel",
            "round",
            "double_saltbox",
            "saltbox",
            "mansard",
            "quadruple_saltbox",
            "round_gabled",
            "pitched",
            "gable",
            "crosspitched",
            "hip",
            "side_hipped",
            "half_hipped",
            "side_half-hipped",
            "hipped-and-gabled",
            "pyramid",
            "lean_to",
            "monopitch",
            "mono-pitched",
            "shed",
            "single",
            "barrel",
            "arched"
          ],
          "#b35a3c",
          "#c9c9c9"
        ]
      ]
    ],
    "building-opacity": 1,
    "building-vertical-gradient": true
  }
}
