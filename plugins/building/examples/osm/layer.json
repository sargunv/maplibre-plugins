{
  "id": "osm-buildings",
  "type": "building",
  "source": "osm-buildings",
  "layout": {
    "building-roof-shape": [
      "match",
      ["get", "roof:shape"],
      "flat",
      "flat",
      "gabled",
      "gabled",
      "hipped",
      "hipped",
      "half-hipped",
      "half-hipped",
      "pyramidal",
      "pyramidal",
      "skillion",
      "skillion",
      "gambrel",
      "gambrel",
      "round",
      "round",
      "double_saltbox",
      "double_saltbox",
      "saltbox",
      "saltbox",
      "mansard",
      "mansard",
      "dome",
      "dome",
      "quadruple_saltbox",
      "quadruple_saltbox",
      "round_gabled",
      "round_gabled",
      "onion",
      "onion",
      "cone",
      "cone",
      "many",
      "many",
      ["pitched", "gable", "crosspitched"],
      "gabled",
      ["hip", "side_hipped"],
      "hipped",
      ["half_hipped", "side_half-hipped", "hipped-and-gabled"],
      "half-hipped",
      ["pyramid"],
      "pyramidal",
      ["lean_to", "monopitch", "mono-pitched", "shed", "single"],
      "skillion",
      ["barrel", "arched"],
      "round",
      ["spherical", "half-dome"],
      "dome",
      ["conical"],
      "cone",
      "flat"
    ],
    "building-roof-orientation": [
      "match",
      ["get", "roof_orientation"],
      "across",
      "across",
      "along"
    ],
    "building-roof-direction": ["coalesce", ["get", "roof_direction_deg"], -1]
  },
  "paint": {
    "building-height": [
      "case",
      ["has", "height_m"],
      ["get", "height_m"],
      [
        "+",
        [
          "*",
          3,
          [
            "coalesce",
            ["get", "levels"],
            ["max", 2, ["+", 1, ["coalesce", ["get", "min_level"], 0]]]
          ]
        ],
        [
          "match",
          ["get", "roof:shape"],
          [
            "gabled",
            "hipped",
            "half-hipped",
            "pyramidal",
            "skillion",
            "gambrel",
            "round",
            "double_saltbox",
            "saltbox",
            "mansard",
            "dome",
            "quadruple_saltbox",
            "round_gabled",
            "onion",
            "cone",
            "pitched",
            "gable",
            "crosspitched",
            "hip",
            "side_hipped",
            "half_hipped",
            "side_half-hipped",
            "hipped-and-gabled",
            "pyramid",
            "lean_to",
            "monopitch",
            "mono-pitched",
            "shed",
            "single",
            "barrel",
            "arched",
            "spherical",
            "half-dome",
            "conical"
          ],
          [
            "case",
            ["has", "roof_height_m"],
            ["get", "roof_height_m"],
            ["has", "roof_levels"],
            ["*", 3, ["get", "roof_levels"]],
            [
              "match",
              ["get", "roof:shape"],
              [
                "skillion",
                "lean_to",
                "monopitch",
                "mono-pitched",
                "shed",
                "single"
              ],
              2,
              ["pyramidal", "dome", "pyramid", "spherical", "half-dome"],
              4,
              ["onion", "cone", "conical"],
              6,
              3
            ]
          ],
          0
        ]
      ]
    ],
    "building-base": [
      "case",
      ["has", "min_height_m"],
      ["get", "min_height_m"],
      ["*", 3, ["coalesce", ["get", "min_level"], 0]]
    ],
    "building-roof-height": [
      "case",
      ["has", "roof_height_m"],
      ["get", "roof_height_m"],
      ["has", "roof_levels"],
      ["*", 3, ["get", "roof_levels"]],
      [
        "match",
        ["get", "roof:shape"],
        ["skillion", "lean_to", "monopitch", "mono-pitched", "shed", "single"],
        2,
        ["pyramidal", "dome", "pyramid", "spherical", "half-dome"],
        4,
        ["onion", "cone", "conical"],
        6,
        3
      ]
    ],
    "building-roof-angle": [
      "case",
      ["has", "roof_height_m"],
      0,
      ["coalesce", ["get", "roof_angle_deg"], 0]
    ],
    "building-color": "#e2ddd5",
    "building-roof-color": [
      "case",
      ["has", "roof:shape"],
      "#bf6f52",
      "#c9c4bb"
    ],
    "building-opacity": 1,
    "building-vertical-gradient": true
  }
}
