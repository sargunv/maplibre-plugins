{
  "name": "@maplibre-plugins/animated-icon",
  "version": "0.2.0",
  "description": "Animated vector icons for maplibre-gl-js, drawn from a baked Lottie catalog with per-feature animation, playback and paint, sharing its spec, catalog and shaders with the MapLibre Native plugin.",
  "license": "BSD-2-Clause",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" }
  },
  "files": ["dist"],
  "scripts": { "build": "vp pack", "test": "vp test run", "check": "vp check" },
  "dependencies": {
    "@maplibre-plugins/paint": "workspace:*",
    "@maplibre/maplibre-gl-style-spec": "catalog:"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "maplibre-gl": "catalog:",
    "pbf": "^5.1.2",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": { "maplibre-gl": ">=6.10 <7" },
  "publishConfig": {
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    }
  }
}
